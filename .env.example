VITE_API_URL=https://app.autopartspro.au/api/v1
# Stripe — BYOK. This store's publishable key now comes back from the
# create-intent API response (set once, in the dashboard's Settings →
# Payment Account), not a build-time env var here — see src/lib/stripe.ts.
# This storefront's own tenant slug — the backend is now multi-tenant and
# needs to know which tenant every request belongs to. Each storefront
# deployment is single-tenant, so this is fixed per deployment. Must match
# the `slug` field on that tenant's Tenant record in the dashboard backend.
VITE_TENANT_SLUG=parts-hub-australia
