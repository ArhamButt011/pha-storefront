VITE_API_URL=https://app.autopartspro.au/api/v1
# REQUIRED — this tenant's own slug on the backend, sent as X-Tenant-Slug on
# every guest request (server/src/middlewares/tenant.js in pha-dashboard).
# There is no Host-based fallback: this is the ONLY way the backend knows
# which tenant a guest request belongs to. Missing => the app refuses to
# start (see lib/api/client.ts). Wrong-but-present => NOT an error — it
# silently serves a DIFFERENT tenant's catalog/orders. Never copy-paste this
# value from another tenant's config. Must match the `slug` field on that
# tenant's Tenant record in the dashboard backend. See MIGRATION.md.
VITE_TENANT_SLUG=parts-hub-australia
# Stripe — BYOK. This store's publishable key now comes back from the
# create-intent API response (set once, in the dashboard's Settings →
# Payment Account), not a build-time env var here — see src/lib/stripe.ts.
